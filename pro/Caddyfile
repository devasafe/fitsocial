:3000 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server

	# Cabecalhos que o painel merece e o app publico nao precisa: aqui um
	# profissional le treino, constancia e conversa de outras pessoas.
	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	@hashed path_regexp \.[0-9a-zA-Z_-]{8,}\.(js|css|woff2?)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
