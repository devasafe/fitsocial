:3000 {
	root * /srv
	encode zstd gzip
	try_files {path} /index.html
	file_server

	# Cabecalhos que o painel merece e o app publico nao precisa: aqui um
	# profissional le treino, constancia e conversa de outras pessoas.
	header {
		-Server
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Cache longo para os assets com hash no nome; o HTML nunca.
	#
	# O matcher do HTML e "tudo que NAO e asset com hash", e nao
	# `header /index.html`: aquele casa o CAMINHO PEDIDO, e ninguem pede
	# /index.html -- pedem "/", que o try_files resolve internamente. A raiz
	# voltava sem Cache-Control, o navegador decidia sozinho, e quem ja tinha
	# aberto ficava preso na versao antiga -- o HTML velho aponta para o bundle
	# velho, que continua no ar por ser imutavel.
	#
	# Os tres Caddyfile do repo tinham o mesmo defeito, e foram consertados em
	# tres momentos diferentes justamente por serem tres arquivos. Se aparecer
	# um quarto servico, comece daqui.
	@hashed path_regexp [.-][0-9a-zA-Z_-]{8,}\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|map)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@html not path_regexp [.-][0-9a-zA-Z_-]{8,}\.(js|css|woff2?|ttf|otf|png|jpe?g|gif|svg|webp|map)$
	header @html Cache-Control "no-cache"
}
