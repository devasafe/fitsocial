# Porta da API
PORT=4000

# Conexão MongoDB (local ou Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/fitsocial

# Segredo para assinar os JWT (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=30d

# Camada de IA (Fatias 2 e 3). Provider trocável: gemini (default).
AI_PROVIDER=gemini
# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo do Gemini (ajuste conforme o disponível no seu tier gratuito)
GEMINI_MODEL=gemini-3.5-flash

# Origens permitidas para CORS, separadas por vírgula. Use * apenas em dev.
# Em produção precisa incluir o app E o painel:
#   CORS_ORIGIN=https://fit.satriz.club,https://admin.fit.satriz.club
CORS_ORIGIN=*

# --- Armazenamento de imagens (Fase 1) ---
# "disk" = salva em ./uploads (bom p/ dev; efêmero na Render). "s3" = S3/R2/MinIO.
STORAGE_PROVIDER=disk
# Preencha só quando STORAGE_PROVIDER=s3. Para MinIO na VPS/Coolify:
#   S3_ENDPOINT = URL pública HTTPS do MinIO (ex.: https://minio.seu-dominio.com)
#   MEDIA_PUBLIC_BASE_URL = base pública de leitura dos objetos (ex.: https://minio.seu-dominio.com/fotos)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=

# YouTube Data API v3 — habilita os vídeos de execução dos exercícios (opcional).
# Sem esta chave, o app mostra um botão que abre a busca no YouTube por fora.
# Para obter: Google Cloud Console → enable "YouTube Data API v3" → API key (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
YOUTUBE_API_KEY=

# --- Telemetria de IA (painel administrativo) ---
# Teto diário por chave, só para o painel mostrar "quanto já queimei hoje".
# Não bloqueia nada; o rótulo é a posição da chave na env (gemini#1, groq#1...).
AI_DAILY_LIMITS=
# Por quantos dias guardar o detalhe de cada chamada de IA (TTL da coleção).
AI_USAGE_RETENTION_DAYS=180

# --- Resiliência da IA ---
# Prazo de cada chamada, medido em produção: o Gemini responde em 17-20s quando
# está bom e passa de 45s quando trava; o Groq entrega em 9-12s. 25s mantém o
# Gemini no caminho feliz e corta cedo quando ele engasga.
AI_TIMEOUT_MS=25000
# Quantas vezes insistir na MESMA chave quando o erro é passageiro (5xx).
# Prazo estourado nunca é repetido: cair para a próxima chave é mais rápido.
AI_RETRIES=1
# Teto de tokens na resposta. Sem ele o Groq corta o JSON do plano no meio e o
# erro que aparece ("Failed to validate JSON") parece problema de prompt.
AI_MAX_OUTPUT_TOKENS=8000

# Segunda IA da cadeia. Na prática não é opcional: é o que separa "demorou um
# pouco mais" de "deu erro" quando o Gemini fica instável. Grátis em console.groq.com.
GROQ_API_KEYS=
# Conferido em 09/09/2026: llama-3.3-70b-versatile saiu do catálogo do Groq.
GROQ_MODEL=openai/gpt-oss-120b

# --- Painel administrativo ---
# Validade da sessão do painel. Curta de propósito: quem entra ali apaga contas.
# O token do app (30 dias) NÃO serve para o painel — são escopos diferentes.
ADMIN_SESSION_EXPIRES_IN=12h

# ---- Push (Expo) ----
# Opcional. O envio funciona sem ele, com limite de taxa mais apertado e sem
# proteção contra quem descobrir os tokens dos aparelhos. Gera-se em
# expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=
